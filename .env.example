# Comma-separated exact hostnames. Default permits local testing only.
SCANNER_ALLOWED_HOSTS=localhost,127.0.0.1

# Before deployment, set a long random value. A development-only default exists for local learning.
SCANNER_SECRET_KEY=replace-with-a-long-random-secret

# Optional SQLAlchemy URL. A fresh SQLite DB is created in the current backend working directory by default.
# DATABASE_URL=sqlite:///./security_scanner.db

# Scanner execution limits & timeouts
SCANNER_TIMEOUT_SECONDS=4.0
SCANNER_RATE_LIMIT_RPS=10.0

# Optional: live HLR / spam-reputation lookup for the Number Trace panel.
# Leave unset to run the trace engine fully offline (carrier database only).
# Providers: numverify | abstractapi | ipqualityscore
# PHONE_LOOKUP_PROVIDER=numverify
# PHONE_LOOKUP_API_KEY=your-api-key

# Deep link analysis (POST /api/analyze-link) performs outbound lookups to
# public, keyless reputation feeds (OTX, URLhaus, OpenPhish, Safe Browsing),
# RDAP and an IP geolocation service. Set to 0 to disable all outbound calls.
# PHONE_DEEP_LINK_ANALYSIS=1
